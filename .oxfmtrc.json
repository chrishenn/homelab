{
  "ignorePatterns": ["*.toml"],
  "semi": false,
  "singleQuote": true,
  "tabWidth": 4,
  "printWidth": 120,
  "bracketSpacing": false,
  "overrides": [
    {
      "files": ["*.yml", "*.yaml", "*.json", "*.jsonl", "*.jsonc", "*.prettierrc"],
      "options": {
        "tabWidth": 2,
        "printWidth": 240
      }
    },
    {
      "files": ["*.conf"],
      "options": {
        "tabWidth": 4,
        "printWidth": 240
      }
    },
    {
      "files": ["Pulumi*yaml"],
      "options": {
        "tabWidth": 2,
        "printWidth": 120
      }
    }
  ]
}
