amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["oxfmt"] = (Builtins.oxfmt) { stomp = false }
  ["ruff_format"] = (Builtins.ruff_format) { output_summary = "hide"; stomp = false }
  ["ruff"] = Builtins.ruff

  ["shfmt"] = Builtins.shfmt
  ["shellharden"] = Builtins.shellharden
  ["shellcheck"] = (Builtins.shellcheck) {
    exclude = List("*deprecated*")
    check =
      "shellcheck --exclude=SC1008,SC2002,SC2088,SC2129,SC2164,SC2317,SC1091,SC2009,SC1090 {{files}}"
  }

  ["pkl"] = Builtins.pkl
  ["pkl_format"] = Builtins.pkl_format
  ["just"] = Builtins.just_format
  ["ryl"] = Builtins.ryl
  ["ryl_markdown"] = (Builtins.ryl_markdown) {
    check = new CommandSpec {
      command = new Command { argv = List("ryl", "check", "--markdown", "{{files}}") }
      effect = "read"
    }
    check_diff = new CommandSpec {
      command = new Command { argv = List("ryl", "check", "--diff", "--markdown", "{{files}}") }
      effect = "read"
    }
    check_after_diff = true
    check_list_files = new CommandSpec {
      command = new Command {
        argv = List("ryl", "check", "--list-files", "--markdown", "{{files}}")
      }
      effect = "read"
    }
  }

  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_symlinks"] = Builtins.check_symlinks
  ["fix_smart_quotes"] = Builtins.fix_smart_quotes
  ["mixed_line_ending"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["trailing_whitespace"] = Builtins.trailing_whitespace
  ["detect_private_key"] = Builtins.detect_private_key

  //   todo: enable
  //   ["gitleaks"] = Builtins.gitleaks
  //   ["betterleaks"] = Builtins.betterleaks
  //   ["kingfisher"] = Builtins.kingfisher
}

local slow = new Mapping<String, Step> {
  ["ty"] = (Builtins.ty) {
    workspace_indicator = "pyproject.toml"
    exclude = List("rack3/*", "vps0/*")
    check = new CommandSpec {
      command = new Command {
        argv = List("mise", "x", "-C", "{{workspace}}", "-c", "ty check {{workspace_files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("mise", "x", "-C", "{{workspace}}", "-c", "ty check --fix {{workspace_files}}")
      }
      effect = "write"
    }
  }
}

hooks {
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["slow"] {
    fix = true
    steps = slow
  }
}
